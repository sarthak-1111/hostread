# Copy to .env.local for local development. Never commit real keys.

# ---- Taste data (Qloo) -------------------------------------------------------
# live   = call the Qloo API (needs QLOO_API_KEY)
# sample = synthetic, clearly labelled fixtures (no key needed)
# unset  = live if QLOO_API_KEY is set, otherwise sample
QLOO_MODE=sample
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Optional overrides discovered during API verification
# QLOO_DINING_TAG=urn:tag:category:place:restaurant
# QLOO_HEATMAP_BOUNDARY=city

# ---- LLM (any OpenAI-compatible endpoint) -------------------------------------
# Local development with Ollama:
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-oss:120b
LLM_API_KEY=
# 1 for a local single-GPU server; 4+ for hosted endpoints
LLM_MAX_CONCURRENCY=1
# low | medium | high, or empty to omit the parameter
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_MS=120000

# ---- Agent guardrails -----------------------------------------------------------
AGENT_MAX_STEPS=12
AGENT_MAX_API_CALLS=80
AGENT_RUN_TIMEOUT_MS=240000
AGENT_DEEP_DIVE_BRANDS=8
AGENT_PITCHES_UP_FRONT=3

# ---- Rate limits (fresh runs only; cached runs are free) -----------------------
RATE_RUNS_PER_IP_10MIN=8
RATE_RUNS_PER_IP_DAY=60
RATE_GLOBAL_RUNS_DAY=500
RATE_SEARCH_PER_IP_MIN=90
RATE_PITCH_PER_IP_10MIN=20

# ---- Optional shared cache (Upstash Redis / Vercel KV REST) ---------------------
# Without these, caching and rate limits are per server instance (in memory).
KV_REST_API_URL=
KV_REST_API_TOKEN=
